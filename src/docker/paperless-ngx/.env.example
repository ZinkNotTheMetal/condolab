# Copy this file to .env before starting the stack.
# Do not commit the real .env file.
# Prefixed names keep shared secret stores easier to search and manage.

# Routed application URL.
PAPERLESS_URL=https://paperless.zinkzone.tech
PAPERLESS_ALLOWED_HOSTS=paperless.zinkzone.tech
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless.zinkzone.tech

# Generate with: openssl rand -base64 48
PAPERLESS_SECRET_KEY=replace-with-generated-paperless-secret-key

# First admin account created during initial startup.
PAPERLESS_ADMIN_USER=william
# Generate with: openssl rand -base64 24
PAPERLESS_ADMIN_PASSWORD=replace-with-generated-admin-password
PAPERLESS_ADMIN_MAIL=

# Postgres
PAPERLESS_POSTGRES_DB=paperless
PAPERLESS_POSTGRES_USER=paperless
# Generate with: openssl rand -base64 32
PAPERLESS_POSTGRES_PASSWORD=replace-with-generated-postgres-password

# Local MS-01 storage. Databases should not live on the NAS mount.
PAPERLESS_DATA_PATH=/condolab/docker/paperless-ngx/data
PAPERLESS_POSTGRES_PATH=/condolab/databases/paperless-ngx/postgres
PAPERLESS_REDIS_PATH=/condolab/docker/paperless-ngx/redis

# Synology-backed document storage. Current Ansible mounts /volume1/Files at /mnt/Files.
PAPERLESS_CONSUME_PATH=/mnt/Files/condolab/documents/paperless/consume
PAPERLESS_MEDIA_PATH=/mnt/Files/condolab/documents/paperless/media
PAPERLESS_EXPORT_PATH=/mnt/Files/condolab/documents/paperless/export

# OCR and ingestion tuning for CPU-only MS-01 operation.
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_MODE=skip
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_POLLING=60
PAPERLESS_TIME_ZONE=America/Chicago
PAPERLESS_FILENAME_FORMAT={correspondent}/{created_year}/{title}

# Keep early resource usage predictable while the archive grows.
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=1
